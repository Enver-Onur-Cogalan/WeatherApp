# Copy to .env before `docker compose up`.

# Required — compose refuses to start without it. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

ENVIRONMENT=development

# Default reaches Ollama running on the host, which is what you want on macOS.
# With `--profile bundled` on Linux, set this to http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e4b
