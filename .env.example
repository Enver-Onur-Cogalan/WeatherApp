# Copy to .env before `docker compose up`, or let `./install.sh` do it — it writes this
# file, generates the secrets below once, and never rewrites one it has already written.

# Required — compose refuses to start without it. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# The database's own password. Defaults to "weather" so an existing volume keeps working;
# on a server, generate one. Changing it after the volume exists locks the service out of
# its own data, so set it before the first start or not at all.
POSTGRES_PASSWORD=

ENVIRONMENT=development

# Where the model is. Compose cannot vary this by profile, so it is set here:
#   http://host.docker.internal:11434   Ollama on the host (macOS — ADR-0010)
#   http://ollama:11434                 the bundled container (Linux with a GPU)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e4b
