{
  "name": "weatherapp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @weatherapp/mobile",
    "mobile:ios": "npm run ios --workspace @weatherapp/mobile",
    "mobile:android": "npm run android --workspace @weatherapp/mobile",
    "typecheck": "npm run typecheck --workspace @weatherapp/mobile",
    "lint": "npm run lint --workspace @weatherapp/mobile",
    "schema": "node packages/schema/scripts/generate.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
