{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git ls-files:*)",
      "Bash(python3 benchmarks/run.py:*)",
      "Bash(python3 benchmarks/engine_check.py:*)",
      "Bash(python3 benchmarks/report.py:*)",
      "Bash(ollama list:*)",
      "Bash(ollama ps:*)",
      "Bash(ollama show:*)",
      "Bash(curl -s https://api.open-meteo.com/*)",
      "Bash(curl -s http://localhost:11434/*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(mypy:*)",
      "Bash(pytest:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r \".tool_response.filePath // .tool_input.file_path // empty\" | { read -r f; case \"$f\" in */services/api/*.py) root=\"${f%%/services/api/*}/services/api\"; \"$root/.venv/bin/ruff\" format \"$f\" && \"$root/.venv/bin/ruff\" check --fix \"$f\";; esac; } > /dev/null || true",
            "timeout": 30,
            "statusMessage": "ruff"
          }
        ]
      }
    ]
  }
}
