# Copy to .env and fill in. No value here is a working default.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Required. The service refuses to start without it. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

DATABASE_URL=postgresql+asyncpg://weather:weather@localhost:5432/weather
REDIS_URL=redis://localhost:6379/0

# On macOS, Ollama runs on the host — containers have no Metal access (ADR-0010).
# From inside a container use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Set to false to force every request through the agent. Used by the eval suite to
# measure what routing is worth.
ROUTING_ENABLED=true
